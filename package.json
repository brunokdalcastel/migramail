{
  "name": "migramail",
  "productName": "MigraMail",
  "version": "0.1.1",
  "description": "Migração de caixas de e-mail IMAP para Windows",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist": "npm run icon && npm run fetch-imapsync && npm run licenses && npm run build && electron-builder --win",
    "screenshots": "npm run build && electron scripts/screenshots.cjs",
    "icon": "tsx scripts/make-icon.ts",
    "fetch-imapsync": "tsx scripts/fetch-imapsync.ts",
    "licenses": "tsx scripts/third-party-licenses.ts",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "echarts": "6.1.0",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "license": "MIT"
}
